generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Enterprise {
  id           String   @id @default(cuid())
  name         String
  code         String   @unique
  contactName  String?
  contactPhone String?
  status       String   @default("ACTIVE")
  remark       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users   User[]
  tickets Ticket[]

  @@index([status])
}

model User {
  id             String    @id @default(cuid())
  enterpriseId   String?
  email          String    @unique
  passwordHash   String?
  name           String
  phone          String?
  role           String
  status         String    @default("INVITED")
  invitedAt      DateTime?
  activatedAt    DateTime?
  lastLoginAt    DateTime?
  mustChangePassword Boolean @default(false)
  passwordChangedAt  DateTime?
  tokenVersion       Int      @default(0)
  /** TOTP 密钥；totpEnabledAt 非空表示已启用 */
  totpSecret         String?
  totpEnabledAt      DateTime?
  /** 恢复码（JSON：仅保存哈希与使用时间） */
  totpRecoveryCodes  String?
  /** 最近一次校验通过的时间步，防止同一动态码重放 */
  totpLastStep       Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  enterprise      Enterprise?      @relation(fields: [enterpriseId], references: [id])
  reportedTickets Ticket[]         @relation("Reporter")
  assignedTickets Ticket[]         @relation("Assignee")
  groupMembers    GroupMember[]
  tokens          AuthToken[]
  refreshTokens   RefreshToken[]
  favoriteTickets TicketFavorite[]
  loginChallenges LoginChallenge[]
  trustedDevices  TrustedDevice[]

  @@index([enterpriseId, role])
  @@index([status])
}

model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  type      String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, type])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model OpsGroup {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members    GroupMember[]
  tickets    Ticket[]
  categories Category[]
}

model GroupMember {
  id      String  @id @default(cuid())
  groupId String
  userId  String
  isLead  Boolean @default(false)

  group OpsGroup @relation(fields: [groupId], references: [id])
  user  User     @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
  @@index([userId])
}

model Category {
  id             String   @id @default(cuid())
  name           String   @unique
  defaultGroupId String
  sort           Int      @default(0)
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  defaultGroup OpsGroup @relation(fields: [defaultGroupId], references: [id])
  tickets      Ticket[]

  @@index([status])
}

model Ticket {
  id             String    @id @default(cuid())
  ticketNo       String    @unique
  /// CUSTOMER=客户工单（含代客提单），INTERNAL=内部工单（不挂企业）
  ticketType     String    @default("CUSTOMER")
  /// 内部工单为空
  enterpriseId   String?
  /// 运维账号代客户提单时为 true
  onBehalf       Boolean   @default(false)
  reporterId     String
  title          String
  description    String
  categoryId     String
  priority       String    @default("P3")
  status         String    @default("PENDING")
  groupId        String
  assigneeId     String?
  resolution     String?
  resolvedAt     DateTime?
  confirmedAt    DateTime?
  closedAt       DateTime?
  closedById     String?
  closeReason    String?
  /// 关闭来源：REPORTER_CONFIRMED / ASSIGNEE_CLOSED / ADMIN_FORCE_CLOSED
  closeSource    String?
  cancelledAt    DateTime?
  cancelReason   String?
  /// 处理工时（小时，一位小数）
  workHours      Float?
  reopenCount    Int       @default(0)
  version        Int       @default(0)
  lastActivityAt DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  enterprise  Enterprise?          @relation(fields: [enterpriseId], references: [id])
  reporter    User                 @relation("Reporter", fields: [reporterId], references: [id])
  assignee    User?                @relation("Assignee", fields: [assigneeId], references: [id])
  category    Category             @relation(fields: [categoryId], references: [id])
  group       OpsGroup             @relation(fields: [groupId], references: [id])
  comments    TicketComment[]
  attachments TicketAttachment[]
  events      TicketEvent[]
  favorites     TicketFavorite[]
  relationsFrom TicketRelation[] @relation("TicketRelationFrom")
  relationsTo   TicketRelation[] @relation("TicketRelationTo")

  @@index([enterpriseId, status, lastActivityAt])
  @@index([groupId, status])
  @@index([assigneeId, status])
  @@index([ticketNo])
}

model TicketComment {
  id         String    @id @default(cuid())
  ticketId   String
  authorId   String
  authorName String
  authorRole String
  visibility String    @default("PUBLIC")
  content    String
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())

  ticket      Ticket             @relation(fields: [ticketId], references: [id])
  attachments TicketAttachment[]

  @@index([ticketId, createdAt])
}

model TicketAttachment {
  id           String   @id @default(cuid())
  ticketId     String
  commentId    String?
  uploaderId   String
  originalName String
  storedPath   String
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())

  ticket  Ticket         @relation(fields: [ticketId], references: [id])
  comment TicketComment? @relation(fields: [commentId], references: [id])

  @@index([ticketId])
  @@index([commentId])
}

model TicketEvent {
  id         String   @id @default(cuid())
  ticketId   String
  actorId    String?
  actorName  String
  action     String
  fromValue  String?
  toValue    String?
  reason     String?
  visibility String   @default("PUBLIC")
  meta       String?
  createdAt  DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])

  @@index([ticketId, createdAt])
}

/// 工单收藏：个人级数据，每位用户独立
model TicketFavorite {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([ticketId, userId])
  @@index([userId, createdAt])
}

/// 工单关联：多对多；入库时按 id 排序归一化，保证无重复
model TicketRelation {
  id              String   @id @default(cuid())
  ticketId        String
  relatedTicketId String
  createdById     String
  createdAt       DateTime @default(now())

  ticket        Ticket @relation("TicketRelationFrom", fields: [ticketId], references: [id])
  relatedTicket Ticket @relation("TicketRelationTo", fields: [relatedTicketId], references: [id])

  @@unique([ticketId, relatedTicketId])
  @@index([relatedTicketId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  ticketId  String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model EmailOutbox {
  id            String    @id @default(cuid())
  ticketId      String?
  toEmail       String
  subject       String
  bodyHtml      String
  bodyText      String
  template      String
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  lastError     String?
  nextAttemptAt DateTime?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([status, nextAttemptAt])
}

model AppSetting {
  key       String   @id
  value     String
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  detail     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/** 登录二次验证挑战：一次性票据，带过期与尝试次数限制 */
model LoginChallenge {
  id          String    @id @default(cuid())
  userId      String
  /** SLIDER / EMAIL_CODE / TOTP / TOTP_ENROLL */
  mode        String
  tokenHash   String    @unique
  /** 滑块目标坐标 / 邮件验证码哈希 / TOTP 待绑定密钥 */
  secret      String?
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  sendCount   Int       @default(0)
  lastSentAt  DateTime?
  expiresAt   DateTime
  consumedAt  DateTime?
  ip          String?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, mode])
  @@index([expiresAt])
}

/** 信任设备：邮件验证码通过后可免验证登录，可查看与撤销 */
model TrustedDevice {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  userAgent  String?
  ip          String?
  lastUsedAt DateTime?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
}
